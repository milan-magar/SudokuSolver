{
  "manifest_version": 3,
  "name": "Sudoku Solver",
  "version": "1.0",
  "description": "Capture Sudoku puzzles from any webpage and solve them.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}